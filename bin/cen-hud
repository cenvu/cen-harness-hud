#!/usr/bin/env python3
"""cen-harness-hud — installer/manager CLI (stdlib only).

Commands: install | doctor | uninstall   (--help, --version)
Deferred by design: update, codex discover, personal-profile restore.
"""

import argparse
import os
import sys

_HERE = os.path.dirname(os.path.realpath(os.path.abspath(__file__)))
SOURCE_ROOT = os.path.dirname(_HERE)

sys.path.insert(0, SOURCE_ROOT)

from installer import doctor as doctor_mod # noqa: E402
from installer import transaction # noqa: E402
from installer.paths import ComponentError, Context # noqa: E402

COMPONENT_FLAGS = ("agy", "claude", "codex", "pi", "herdr")


def _version() -> str:
    for root in (SOURCE_ROOT,
                 os.environ.get("CEN_SOURCE_ROOT", "")):
        vpath = os.path.join(root, "VERSION") if root else ""
        if vpath and os.path.isfile(vpath):
            with open(vpath) as f:
                return f.read().strip()
    return "unknown"


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(
        prog="cen-hud",
        description="cen-harness-hud installer / manager (macOS, stdlib)",
    )
    parser.add_argument("--version", action="store_true")
    sub = parser.add_subparsers(dest="cmd")

    p_inst = sub.add_parser("install", help="install HUD (sandbox-safe)")
    p_inst.add_argument("--source-root", default=None,
                        help="product source root (set by install.sh)")
    for flag in COMPONENT_FLAGS:
        p_inst.add_argument(f"--{flag}", action="store_true",
                            help=f"include {flag} component")
    p_inst.add_argument(
        "--codex-home", action="append", default=[], metavar="PATH",
        help="include an existing HOME-relative Codex profile (repeatable; "
             "requires --codex)",
    )

    sub.add_parser("doctor", help="strictly read-only verification")
    p_un = sub.add_parser("uninstall", help="drift-safe uninstall")

    args = parser.parse_args(argv)

    if args.version:
        print(_version())
        return 0
    if not args.cmd:
        parser.print_help()
        return 0

    home = os.environ.get("HOME")
    if not home:
        print("cen-hud: HOME is not set", file=sys.stderr)
        return 1

    source_root = getattr(args, "source_root", None) or SOURCE_ROOT
    raw_codex_homes = getattr(args, "codex_home", [])
    if raw_codex_homes and not getattr(args, "codex", False):
        print("cen-hud: --codex-home requires --codex", file=sys.stderr)
        return 1
    try:
        ctx = Context(
            home=home,
            source_root=source_root,
            codex_homes=raw_codex_homes,
        )
    except ComponentError as e:
        print("cen-hud: " + str(e), file=sys.stderr)
        return 1

    if args.cmd == "install":
        explicit = [f for f in COMPONENT_FLAGS if getattr(args, f)]
        if explicit:
            selections = [(name, True) for name in explicit]
        else:
            selections = [(name, False) for name in COMPONENT_FLAGS]
        return transaction.run_install(ctx, selections)

    if args.cmd == "doctor":
        return doctor_mod.run_doctor(ctx)

    if args.cmd == "uninstall":
        return transaction.run_uninstall(ctx)

    parser.print_help()
    return 0


if __name__ == "__main__":
    sys.exit(main())
