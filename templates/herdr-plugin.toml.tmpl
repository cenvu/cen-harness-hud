id = "cen-harness-hud-quota"
name = "CEN Harness HUD Quota"
version = "0.1.0"
min_herdr_version = "0.8.0"
description = "Provider-scoped AI agent quota badges for Herdr (AGY and Codex)"
platforms = ["macos", "linux"]

[[events]]
id = "cen-agent-detected"
on = "pane.agent_detected"
command = ["{{PYTHON}}", "{{SCOPED_EVENT}}"]

[[events]]
id = "cen-agent-status-changed"
on = "pane.agent_status_changed"
command = ["{{PYTHON}}", "{{SCOPED_EVENT}}"]
